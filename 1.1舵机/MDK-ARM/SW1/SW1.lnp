--cpu Cortex-M3
"sw1\startup_stm32f103xb.o"
"sw1\main.o"
"sw1\stm32f1xx_it.o"
"sw1\stm32f1xx_hal_msp.o"
"sw1\stm32f1xx_hal_gpio_ex.o"
"sw1\stm32f1xx_hal_tim.o"
"sw1\stm32f1xx_hal_tim_ex.o"
"sw1\stm32f1xx_hal.o"
"sw1\stm32f1xx_hal_rcc.o"
"sw1\stm32f1xx_hal_rcc_ex.o"
"sw1\stm32f1xx_hal_gpio.o"
"sw1\stm32f1xx_hal_dma.o"
"sw1\stm32f1xx_hal_cortex.o"
"sw1\stm32f1xx_hal_pwr.o"
"sw1\stm32f1xx_hal_flash.o"
"sw1\stm32f1xx_hal_flash_ex.o"
"sw1\stm32f1xx_hal_exti.o"
"sw1\stm32f1xx_hal_uart.o"
