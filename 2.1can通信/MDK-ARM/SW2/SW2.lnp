"sw2\stm32f1xx_hal_rcc_ex.o"
"sw2\stm32f1xx_hal_gpio.o"
"sw2\stm32f1xx_hal_dma.o"
"sw2\stm32f1xx_hal_cortex.o"
"sw2\stm32f1xx_hal_pwr.o"
